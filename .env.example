# Copy to `.env` and fill in the blank values. `.env` is ignored by git and must never
# be committed. This template lists which variables are needed, without holding any
# real value.

# --- Local PostgreSQL server (Docker Compose) ---
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Application datasource ---
# In production these point at Neon and come from GitHub Secrets. No POSTGRES_*
# variable exists there, because nothing starts a database server.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobtracker
DATASOURCE_USERNAME=jobtracker
DATASOURCE_PASSWORD=
