# Copy to `.env` and fill in real values. `.env` is gitignored and must never be committed.
#
# Two groups on purpose:
#   POSTGRES_*   configure the local PostgreSQL *server* started by Docker Compose.
#   DATASOURCE_* configure the *client* (this application). In production these point
#                at Neon and come from GitHub Secrets, and no POSTGRES_* var exists.

# --- Local PostgreSQL server (Docker Compose) ---
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Application datasource ---
DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobtracker
DATASOURCE_USERNAME=jobtracker
DATASOURCE_PASSWORD=
