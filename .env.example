# Copy to `.env` and fill in the blank values. `.env` is ignored by git and must never
# be committed. This template lists which variables are needed, without holding any
# real value.

# --- Local PostgreSQL server (Docker Compose) ---
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Application datasource ---
# In production these point at Neon and come from GitHub Secrets. No POSTGRES_*
# variable exists there, because nothing starts a database server.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobtracker
DATASOURCE_USERNAME=jobtracker
DATASOURCE_PASSWORD=

# --- Gmail API ---
# From the Google Cloud OAuth client, plus a refresh token generated by hand with the
# gmail.readonly scope. While the OAuth app is in Testing, Google expires that token
# every seven days: renew it here for local runs, and in the GMAIL_REFRESH_TOKEN
# repository secret for the daily run. See PRIVACY.md for what the app reads.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Google Sheets ---
# The service account key, base64 encoded:  base64 -w0 service-account-key.json
GOOGLE_SHEETS_CREDENTIALS=
# The id in the sheet's URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- WhatsApp (Meta Cloud API) ---
# A system user token that does not expire, granted only whatsapp_business_messaging;
# the Phone Number ID of Meta's free test number; and your own number, digits only, with
# country and area code. In production these come from GitHub Secrets.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
