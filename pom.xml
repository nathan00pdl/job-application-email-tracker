<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.nathanpaiva.jobtracker</groupId>
    <artifactId>job-application-email-tracker</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>job-application-email-tracker</name>
    <description>Daily Gmail scan that tracks job application status via rule-based and LLM classification</description>

    <properties>
        <java.version>25</java.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <google-api-services-gmail.version>v1-rev20260727-2.0.0</google-api-services-gmail.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 4's BOM no longer manages the Testcontainers modules, so
                 their own BOM is imported to keep every testcontainers artifact on a
                 single, consistent version. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Brings Hibernate, Spring Data JPA and, through them, the DataSource and
             JdbcTemplate that spring-boot-starter-jdbc provided before. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot 4 split the autoconfigurations out of spring-boot-autoconfigure
             into per-technology modules. flyway-core alone puts Flyway on the classpath
             but nothing wires it up, so migrations would silently never run: this module
             is what provides FlywayAutoConfiguration (and it brings flyway-core along). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Since Flyway 10 each database engine lives in its own module; without
             this one Flyway starts and then fails to recognise the PostgreSQL URL. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Google's generated client for the Gmail API. This PR only uses its model
             classes (Message, MessagePart); the calls themselves come with the adapter. -->
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-gmail</artifactId>
            <version>${google-api-services-gmail.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Integration tests run against a real, disposable PostgreSQL container.
             @ServiceConnection (spring-boot-testcontainers) redirects the application's
             DataSource to it, so the migrations under test are the production ones. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
